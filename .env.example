# Liga EDUmind - MODO AULA - variables de entorno
# Copia este archivo a .env (en esta misma carpeta) y rellena los valores,
# o deja que scripts/instalar_aula.sh lo genere por ti.
# El archivo .env NUNCA debe subirse al repositorio.

# --- Obligatorias ---
# Contraseña de PostgreSQL. Genera una con: openssl rand -hex 16
POSTGRES_PASSWORD=

# Clave de firma de los tokens de sesión. Genera una con: openssl rand -hex 32
SECRET_KEY=

# --- Opcionales ---
# Puerto en el que se sirve la app en la red del centro
AULA_PORT=8080

# Máximo de ligas por docente en esta instancia (sin límite SaaS)
AULA_MAX_LIGAS=100

# Correo saliente. Sin esto la app funciona con normalidad,
# pero no puede enviar fichas de juego por email.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Liga EDUmind
